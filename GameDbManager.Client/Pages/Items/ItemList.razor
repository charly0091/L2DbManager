@page "/items"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ItemService ItemService
@using GameDbManager.Client.Models.Items
@using GameDbManager.Client.Services.Items
@using System.Linq

<PageTitle>Items Management</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="oi oi-list"></i> Items Database</h2>
        <div>
            <a href="/items/create" class="btn btn-primary me-2"><i class="oi oi-plus"></i> Create New Item</a>
            <a href="/items/import" class="btn btn-secondary"><i class="oi oi-data-transfer-upload"></i> Import Items</a>
        </div>
    </div>

    @if (items == null)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (items.Count == 0)
    {
        <div class="alert alert-info">
            <i class="oi oi-info me-2"></i> No items available. Create or import items to get started.
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-header bg-light">
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="oi oi-magnifying-glass"></i></span>
                            <input type="text" class="form-control" placeholder="Search by name..." @bind="searchTerm" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(searchTerm))
                            {
                                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                                    <i class="oi oi-x"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <select class="form-select" @bind="selectedItemType">
                            <option value="">All Item Types</option>
                            <option value="Accessory">Accessories</option>
                            <option value="Armor">Armor</option>
                            <option value="Weapon">Weapons</option>
                            <option value="Jewelry">Jewelry</option>
                            <option value="Etc">Other Items</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="d-flex justify-content-md-end">
                            <span class="me-2 mt-2">@filteredItems.Count items</span>
                            <button class="btn btn-outline-secondary" @onclick="ExportItems" title="Export Items">
                                <i class="oi oi-data-transfer-download"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;"></th>
                            <th>
                                <a href="javascript:void(0)" @onclick='() => SortBy("Name")'>
                                    Name
                                    @if (sortField == "Name")
                                    {
                                        <span>@(sortAscending ? "▲" : "▼")</span>
                                    }
                                </a>
                            </th>
                            <th>Type</th>
                            <th>
                                <a href="javascript:void(0)" @onclick='() => SortBy("Price")'>
                                    Price
                                    @if (sortField == "Price")
                                    {
                                        <span>@(sortAscending ? "▲" : "▼")</span>
                                    }
                                </a>
                            </th>
                            <th>
                                <a href="javascript:void(0)" @onclick='() => SortBy("Weight")'>
                                    Weight
                                    @if (sortField == "Weight")
                                    {
                                        <span>@(sortAscending ? "▲" : "▼")</span>
                                    }
                                </a>
                            </th>
                            <th>Properties</th>
                            <th style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in filteredItems)
                        {
                            <tr @onclick="() => ViewItemDetails(item.Id)" class="cursor-pointer">
                                <td class="align-middle">
                                    @if (!string.IsNullOrEmpty(item.Icon))
                                    {
                                        <img src="@GetIconUrl(item.Icon)" alt="@item.Name" class="item-icon" style="width: 32px; height: 32px;" />
                                    }
                                </td>
                                <td class="align-middle">@item.Name</td>
                                <td class="align-middle">
                                    <span class="badge @GetTypeBadgeClass(item)">
                                        @GetItemTypeName(item)
                                    </span>
                                </td>
                                <td class="align-middle">@item.Price.ToString("N0")</td>
                                <td class="align-middle">@item.Weight</td>
                                <td class="align-middle">
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (item.Sellable)
                                        {
                                            <span class="badge bg-success" title="Sellable"><i class="oi oi-dollar"></i></span>
                                        }
                                        @if (item.Tradeable)
                                        {
                                            <span class="badge bg-info" title="Tradeable"><i class="oi oi-transfer"></i></span>
                                        }
                                        @if (item.Dropable)
                                        {
                                            <span class="badge bg-warning" title="Dropable"><i class="oi oi-arrow-bottom"></i></span>
                                        }
                                        @if (!item.Destroyable)
                                        {
                                            <span class="badge bg-danger" title="Not Destroyable"><i class="oi oi-shield"></i></span>
                                        }
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <div class="btn-group" role="group">
                                        <button @onclick:stopPropagation="true" @onclick="() => ViewItemDetails(item.Id)" class="btn btn-sm btn-info">
                                            <i class="oi oi-eye"></i>
                                        </button>
                                        <button @onclick:stopPropagation="true" @onclick="() => NavigateToEdit(item.Id)" class="btn btn-sm btn-primary">
                                            <i class="oi oi-pencil"></i>
                                        </button>
                                        <button @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(item.Id)" class="btn btn-sm btn-danger">
                                            <i class="oi oi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (filteredItems.Count > 0)
            {
                <div class="card-footer">
                    <nav>
                        <ul class="pagination justify-content-center mb-0">
                            @for (int i = 1; i <= Math.Ceiling(filteredItems.Count / (double)pageSize); i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0)" @onclick="() => GoToPage(pageNumber)">@pageNumber</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
</div>

<!-- Item Details Modal -->
<div class="modal fade @(showDetailsModal ? "show" : "")" tabindex="-1" style="display: @(showDetailsModal ? "block" : "none")">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @if (selectedItem != null)
                    {
                        @selectedItem.Name
                    }
                </h5>
                <button type="button" class="btn-close" @onclick="CloseDetailsModal"></button>
            </div>
            <div class="modal-body">
                @if (selectedItem != null)
                {
                    <div class="row">
                        <div class="col-md-4 text-center mb-3">
                            @if (!string.IsNullOrEmpty(selectedItem.Icon))
                            {
                                <img src="@GetIconUrl(selectedItem.Icon)" alt="@selectedItem.Name" class="img-fluid mb-3" style="max-height: 128px;" />
                            }
                            <div>
                                <span class="badge @GetTypeBadgeClass(selectedItem) fs-5">@GetItemTypeName(selectedItem)</span>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title">Price</h6>
                                            <p class="card-text fs-4">@selectedItem.Price.ToString("N0")</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title">Weight</h6>
                                            <p class="card-text fs-4">@selectedItem.Weight</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <h6>Properties</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge @(selectedItem.Sellable ? "bg-success" : "bg-secondary")">Sellable</span>
                                    <span class="badge @(selectedItem.Tradeable ? "bg-success" : "bg-secondary")">Tradeable</span>
                                    <span class="badge @(selectedItem.Dropable ? "bg-success" : "bg-secondary")">Dropable</span>
                                    <span class="badge @(selectedItem.Destroyable ? "bg-success" : "bg-secondary")">Destroyable</span>
                                </div>
                            </div>

                            @if (selectedItem.ItemType != "Etc")
                            {
                                <div class="mt-3">
                                    <h6>Equipment Details</h6>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm">
                                            <tr>
                                                <th>Body Part</th>
                                                <td>@selectedItem.BodyPart</td>
                                            </tr>
                                            <tr>
                                                <th>Grade</th>
                                                <td>@selectedItem.Grade</td>
                                            </tr>
                                            <tr>
                                                <th>Crystallizable</th>
                                                <td>@(selectedItem.Crystallizable ? "Yes" : "No")</td>
                                            </tr>
                                            @if (selectedItem.ItemType == "Armor" && !string.IsNullOrEmpty(selectedItem.ArmorType))
                                            {
                                                <tr>
                                                    <th>Armor Type</th>
                                                    <td>@selectedItem.ArmorType</td>
                                                </tr>
                                            }
                                            @if (selectedItem.ItemType == "Weapon" && !string.IsNullOrEmpty(selectedItem.WeaponType))
                                            {
                                                <tr>
                                                    <th>Weapon Type</th>
                                                    <td>@selectedItem.WeaponType</td>
                                                </tr>
                                            }
                                        </table>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="mt-3">
                                    <h6>Item Details</h6>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm">
                                            <tr>
                                                <th>Item Type</th>
                                                <td>@selectedItem.EtcItemType</td>
                                            </tr>
                                            <tr>
                                                <th>Stackable</th>
                                                <td>@(selectedItem.Stackable ? "Yes" : "No")</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            }

                            @if (selectedItem.Stats.Any())
                            {
                                <div class="mt-3">
                                    <h6>Item Stats</h6>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Type</th>
                                                    <th>Stat</th>
                                                    <th>Order</th>
                                                    <th>Value</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var stat in selectedItem.Stats)
                                                {
                                                    <tr>
                                                        <td>@stat.StatType</td>
                                                        <td>@stat.Stat</td>
                                                        <td>@stat.Order</td>
                                                        <td>@stat.Value</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }

                            @if (selectedItem.Skills.Any())
                            {
                                <div class="mt-3">
                                    <h6>Item Skills</h6>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Skill ID</th>
                                                    <th>Level</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var skill in selectedItem.Skills)
                                                {
                                                    <tr>
                                                        <td>@skill.SkillId</td>
                                                        <td>@skill.SkillLevel</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                @if (selectedItem != null)
                {
                    <button class="btn btn-primary" @onclick="() => NavigateToEdit(selectedItem.Id)">
                        <i class="oi oi-pencil me-1"></i> Edit
                    </button>
                }
                <button type="button" class="btn btn-secondary" @onclick="CloseDetailsModal">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="@(showDetailsModal ? "modal-backdrop fade show" : "")"></div>

<!-- Delete Confirmation Modal -->
<div class="modal fade @(showDeleteModal ? "show" : "")" tabindex="-1" style="display: @(showDeleteModal ? "block" : "none")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" @onclick="CancelDelete"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this item? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="DeleteConfirmed">
                    <i class="oi oi-trash me-1"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>
<div class="@(showDeleteModal ? "modal-backdrop fade show" : "")"></div>

<style>
    .item-icon {
        object-fit: contain;
    }

    .cursor-pointer {
        cursor: pointer;
    }

        .cursor-pointer:hover {
            background-color: rgba(0,0,0,.05);
        }
</style>

@code {
    private List<ItemDto> items;
    private List<ItemDto> filteredItems => ApplyFilters();
    private int itemIdToDelete;
    private bool showDeleteModal = false;

    // Filtering and sorting
    private string searchTerm = "";
    private string selectedItemType = "";
    private string sortField = "Name";
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 10;
    private int currentPage = 1;

    // Item Details Modal
    private bool showDetailsModal = false;
    private ItemDto selectedItem;

    protected override async Task OnInitializedAsync()
    {
        items = await ItemService.GetItemsAsync();
    }

    private List<ItemDto> ApplyFilters()
    {
        if (items == null)
            return new List<ItemDto>();

        var result = items.AsQueryable();

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            result = result.Where(i => i.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        // Apply type filter
        if (!string.IsNullOrWhiteSpace(selectedItemType))
        {
            result = result.Where(i => i.ItemType == selectedItemType);
        }

        // Apply sorting
        if (sortField == "Name")
        {
            result = sortAscending
                ? result.OrderBy(i => i.Name)
                : result.OrderByDescending(i => i.Name);
        }
        else if (sortField == "Price")
        {
            result = sortAscending
                ? result.OrderBy(i => i.Price)
                : result.OrderByDescending(i => i.Price);
        }
        else if (sortField == "Weight")
        {
            result = sortAscending
                ? result.OrderBy(i => i.Weight)
                : result.OrderByDescending(i => i.Weight);
        }

        return result.ToList();
    }

    private string GetItemTypeName(ItemDto item)
    {
        switch (item.ItemType)
        {
            case "Armor":
                return $"Armor ({item.ArmorType})";
            case "Weapon":
                return $"Weapon ({item.WeaponType})";
            case "Etc":
                return $"Etc ({item.EtcItemType})";
            default:
                return item.ItemType;
        }
    }

    private void SortBy(string field)
    {
        if (sortField == field)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortField = field;
            sortAscending = true;
        }
    }

    private void ClearSearch()
    {
        searchTerm = "";
    }

    private void GoToPage(int page)
    {
        currentPage = page;
    }

    private void ViewItemDetails(int id)
    {
        selectedItem = items.FirstOrDefault(i => i.Id == id);
        showDetailsModal = true;
        StateHasChanged();
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedItem = null;
    }

    private void NavigateToEdit(int id)
    {
        Navigation.NavigateTo("/items/edit/" + id);
    }

    private void ConfirmDelete(int id)
    {
        itemIdToDelete = id;
        showDeleteModal = true;
    }

    private async Task DeleteConfirmed()
    {
        await ItemService.DeleteItemAsync(itemIdToDelete);
        items = await ItemService.GetItemsAsync();
        showDeleteModal = false;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
    }

    private string GetIconUrl(string iconPath)
    {
        // Adjust this based on how your icons are stored/served
        return "/images/items/" + iconPath;
    }

    private string GetTypeBadgeClass(ItemDto item)
    {
        switch (item.ItemType)
        {
            case "Accessory":
                return "bg-info";
            case "Weapon":
                return "bg-danger";
            case "Armor":
                return "bg-primary";
            case "Jewelry":
                return "bg-warning text-dark";
            default:
                return "bg-secondary";
        }
    }

    private void ExportItems()
    {
        // Implement export functionality
        // Could download as CSV, Excel, etc.
    }
}